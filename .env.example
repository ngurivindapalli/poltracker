# Local Postgres (docker compose) — used by Prisma
DATABASE_URL="postgresql://politeia:politeia@localhost:5433/politeia?schema=public"

# FEC Open API key — https://api.data.gov/signup/
FEC_API_KEY=

# Supabase cloud accounts + comments
# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). Restart the dev server after changing these.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
