# Local Postgres (docker compose) — used by Prisma
DATABASE_URL="postgresql://politeia:politeia@localhost:5433/politeia?schema=public"

# ---------------------------------------------------------------------------
# Quiver Quantitative (PRIMARY financial data source — Hobbyist plan)
# Copy this file to .env.local and paste your access key.
# NEVER commit real keys. .env.local is gitignored.
# ---------------------------------------------------------------------------
QUIVER_API_KEY=PASTE_YOUR_QUIVER_ACCESS_KEY_HERE
QUIVER_BASE_URL=https://api.quiverquant.com/beta
# Full bulk trade history is ~115k rows (~23 pages @ 5k). Older politician trades
# (e.g. Cory Booker B001288, 2014) sit near the END — do not set a tiny page cap.
# QUIVER_TRADES_MAX_PAGES=80
# QUIVER_TRADES_PAGE_SIZE=5000
# QUIVER_TRADES_PAGE_DELAY_MS=300
# QUIVER_NETWORTH_MAX_PAGES=50
# QUIVER_DONORS_MAX_PAGES=50

# Public site URL (used for server-side fetches and canonical metadata)
NEXT_PUBLIC_SITE_URL=https://politeia.co

# Congress.gov API — https://api.data.gov/signup/
# Server-side only. Never prefix with NEXT_PUBLIC_.
# Required for `npm run sync:legislative`. User-facing pages read PostgreSQL.
API_DATA_GOV_KEY=

# Optional news and AI (server-side only)
# Required for `npm run sync:news`. Pages read cached_news_articles.
NEWS_API_KEY=
OPENAI_API_KEY=

# Groq (Ask Politeia chatbot). Server-side only. Never prefix with NEXT_PUBLIC_.
# Model is pinned in code: openai/gpt-oss-120b
GROQ_API_KEY=

# Optional X/Twitter API v2 bearer (server-side only). Used by /api/twitter/[handle].
# Accepts TWITTER_BEARER_TOKEN or X_BEARER_TOKEN. Never prefix with NEXT_PUBLIC_.
# TWITTER_BEARER_TOKEN=

# FEC Open API key — https://api.data.gov/signup/
# Used by `npm run ingest:fec` and `npm run sync:local-elections`.
# Server-side only. Never prefix with NEXT_PUBLIC_.
FEC_API_KEY=

# Google sign-in (NextAuth). Server-side only except the public site URL.
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://politeia.co
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional aliases also accepted: NEXTAUTH_SECRET, NEXTAUTH_URL, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
# Google Cloud authorized redirect URI:
# https://politeia.co/api/auth/callback/google
# http://localhost:3000/api/auth/callback/google

# Google AdSense display ads. Leave empty until the publisher account is approved.
# Do not invent publisher or slot IDs. Format: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=
