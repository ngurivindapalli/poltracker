# Local Postgres (docker compose) — used by Prisma
DATABASE_URL="postgresql://politeia:politeia@localhost:5433/politeia?schema=public"

# ---------------------------------------------------------------------------
# Quiver Quantitative (PRIMARY financial data source — Hobbyist plan)
# Copy this file to .env.local and paste your access key.
# NEVER commit real keys. .env.local is gitignored.
# ---------------------------------------------------------------------------
QUIVER_API_KEY=PASTE_YOUR_QUIVER_ACCESS_KEY_HERE
QUIVER_BASE_URL=https://api.quiverquant.com/beta
# Full bulk trade history is ~115k rows (~23 pages @ 5k). Older politician trades
# (e.g. Cory Booker B001288, 2014) sit near the END — do not set a tiny page cap.
# QUIVER_TRADES_MAX_PAGES=80
# QUIVER_TRADES_PAGE_SIZE=5000
# QUIVER_TRADES_PAGE_DELAY_MS=300
# QUIVER_NETWORTH_MAX_PAGES=50
# QUIVER_DONORS_MAX_PAGES=50

# Public site URL (used for server-side fetches and canonical metadata)
NEXT_PUBLIC_SITE_URL=https://politeia.co

# Congress.gov API — https://api.data.gov/signup/
# Server-side only. Never prefix with NEXT_PUBLIC_.
# Required for `npm run sync:legislative`. User-facing pages read PostgreSQL.
API_DATA_GOV_KEY=

# Optional news and AI (server-side only)
# Required for `npm run sync:news`. Pages read cached_news_articles.
NEWS_API_KEY=
OPENAI_API_KEY=

# FEC Open API key — https://api.data.gov/signup/
FEC_API_KEY=

# Supabase cloud accounts + comments
# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). Restart the dev server after changing these.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
